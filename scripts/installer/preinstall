#!/bin/bash
# Read-only preflight. Validate both current and former app names.
set -euo pipefail
MANAGER_SCRIPT_ROOT="$(cd "$(dirname "$0")" && pwd)"
source "$MANAGER_SCRIPT_ROOT/common.sh"
manager_initialize "${3:-/}"
MANAGER_FOUND=0
for MANAGER_EXISTING_APP in "$MANAGER_CURRENT_APP" "$MANAGER_LEGACY_APP"; do
  if [[ ! -e "$MANAGER_EXISTING_APP" && ! -L "$MANAGER_EXISTING_APP" ]]; then continue; fi
  manager_check_app "$MANAGER_EXISTING_APP"
  MANAGER_FOUND=1
  if [[ "$MANAGER_OLD_VERSION" == "$MANAGER_NEW_VERSION" && "$MANAGER_OLD_BUILD" == "$MANAGER_NEW_BUILD" ]]; then
    printf 'CodexNeko: reinstalando %s (build %s), mantendo contas e preferências.\n' "$MANAGER_NEW_VERSION" "$MANAGER_NEW_BUILD"
  else
    printf 'CodexNeko: atualização detectada: %s (build %s) → %s (build %s).\n' "$MANAGER_OLD_VERSION" "$MANAGER_OLD_BUILD" "$MANAGER_NEW_VERSION" "$MANAGER_NEW_BUILD"
  fi
done
if [[ "$MANAGER_FOUND" == 0 ]]; then
  printf 'CodexNeko: nova instalação %s (build %s) em Aplicativos.\n' "$MANAGER_NEW_VERSION" "$MANAGER_NEW_BUILD"
fi
